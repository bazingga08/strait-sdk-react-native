{
  "name": "@straitlink/react-native",
  "version": "0.8.1",
  "description": "Deep linking for React Native: direct links (App Links, Universal Links, custom schemes), deferred links that survive the install (Play Install Referrer, iOS device matching, optional clipboard boost) and link-open analytics.",
  "keywords": [
    "react-native",
    "deep-linking",
    "deferred-deep-linking",
    "universal-links",
    "app-links",
    "attribution",
    "dynamic-links"
  ],
  "license": "MIT",
  "author": "The Strait authors",
  "homepage": "https://straitlink.in",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bazingga08/strait-sdk-react-native.git"
  },
  "bugs": {
    "url": "https://github.com/bazingga08/strait-sdk-react-native/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "react-native": "dist/index.native.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.native.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "react-native": ">=0.70"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "brand": "node scripts/brand.mjs"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^4.1.8"
  }
}
